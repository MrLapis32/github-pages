<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Happy Rose Day!</title>
    <style>
        body {
            background-color: #f8e0ff; /* Light Lavender */
            font-family: sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
            margin: 0;
            animation: fadeIn 1s ease-in-out; /* Fade-in animation */
        }

        h1 {
            color: #d8bfd8; /* Thistle */
            font-size: 3em;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2);
            animation: fadeInUp 1.5s ease-in-out; /* Slide-up animation */
        }

        .rose-image {
            width: 200px;
            height: auto;
            margin-top: 20px;
            animation: pulse 2s infinite; /* Heartbeat-like pulse */
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        @keyframes fadeInUp {
            from { transform: translateY(50px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }
        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.1); }
            100% { transform: scale(1); }
        }
    </style>
</head>
<body>
    <h1>Happy Rose Day, Babe!</h1>
    <img class="rose-image" src="rose.png" alt="Rose">  </body>
</html>
